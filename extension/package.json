{
  "name": "tgramsave",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && bun run build:chrome && bun run build:firefox",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci . && bun run typecheck && bun run build",
    "build:chrome": "vite build --mode chrome",
    "build:obf": "OBFUSCATE=1 vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "package:chrome": "bun run build:chrome && node scripts/package.mjs chrome",
    "package:firefox": "bun run build:firefox && node scripts/package.mjs firefox",
    "package": "vue-tsc --noEmit && bun run package:chrome && bun run package:firefox"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lucide/vue": "^1.27.0",
    "blueimp-md5": "^2.19.0",
    "element-plus": "^2.14.3",
    "fflate": "^0.8.3",
    "vue": "^3.5.40",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/blueimp-md5": "^2.18.2",
    "@types/chrome": "^0.2.2",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "javascript-obfuscator": "^5.9.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.8"
  }
}
