KOFI_VERIFICATION_TOKEN=   # Ko-fi > Settings > API > Webhooks > Verification Token (required)
ADMIN_TOKEN=               # >= 32 random chars (openssl rand -hex 32); empty disables /admin
ADDR=:8080
DB_PATH=tgsd.db           # SQLite file (default)
DATABASE_URL=            # postgres://user:pass@host:5432/db?sslmode=require - overrides DB_PATH
CLIENT_IP_HEADER=          # Fly-Client-IP / X-Forwarded-For behind a proxy
DEBUG_WEBHOOKS=          # 1 = log each Ko-fi payload (contains emails), debugging only
